{
  "version": 1,
  "updatedAt": "2026-10-02",
  "note": "小驴生态能力清单（docs/09 审查口径）。maturity: stable=已发布公开契约, design=设计态, unlocated=未定位。design/unlocated 只进 manifest 与诊断，不注册可执行 adapter。2026-10-02 R6 按各仓库远端 main 校准（雷切 0.44.1 +3 能力/打卡 18.16.0 +7 事件/人脉 0.4.1 桥不变）。",
  "plugins": [
    {
      "pluginId": "siyuan-speed-switch",
      "displayName": "小驴雷切",
      "maturity": "stable",
      "version": "0.44.1",
      "protocol": "agent-capabilities + commands",
      "capabilities": ["navigation-state", "search-documents", "workspace-context", "open-document", "open-documents", "create-document", "append-to-journal", "update-task-status", "home-widget-snapshot", "workspace-plan", "execute-workspace-plan", "get-document-outline", "home-adapter-diagnostics", "restore-document-set"],
      "hubIntegration": "commands.run 走命令面板条目；不持有其他插件业务主数据"
    },
    {
      "pluginId": "siyuan-checkin",
      "displayName": "小驴打卡",
      "maturity": "stable",
      "version": "18.16.0",
      "protocol": "window.siyuanCheckin v5",
      "windowBridge": "siyuanCheckin",
      "capabilities": ["items.read", "items.query", "events.read", "events.range.read", "events.record", "events.record.batch", "summary.read", "analytics.read", "metrics.read", "export.json", "export.csv", "calendar.read"],
      "events": [
        { "name": "checkin:event-recorded", "status": "available", "idempotency": "source+externalRef", "payload": { "type": "event-recorded", "event": { "itemId": "string", "value": "number", "occurredAt": "string" } }, "note": "快门已订阅物化（window CustomEvent，v0.5.2 通道修正）" },
        { "name": "checkin:event-deleted", "status": "available", "idempotency": "source+externalRef+:deleted 后缀", "payload": { "type": "event-deleted", "event": "CheckinEvent?", "deletedEvents": "CheckinEvent[]?" }, "note": "已订阅物化（v0.5.4）；删除标记与 recorded 行共存于 append-only 载体" },
        { "name": "checkin:item-created", "status": "observed", "idempotency": "itemId+updatedAt", "payload": { "type": "item-created", "item": "CheckinItem" } },
        { "name": "checkin:item-updated", "status": "observed", "idempotency": "itemId+updatedAt", "payload": { "type": "item-updated", "item": "CheckinItem" } },
        { "name": "checkin:item-deleted", "status": "observed", "idempotency": "itemId+deletedAt", "payload": { "type": "item-deleted", "item": "CheckinItem?" } },
        { "name": "checkin:item-archived", "status": "observed", "idempotency": "itemId+archivePeriod", "payload": { "type": "item-archived", "item": "CheckinItem" }, "note": "仅自动归档路径广播" },
        { "name": "checkin:suggestion-workflow-updated", "status": "observed", "idempotency": "suggestionId+status", "payload": { "type": "suggestion-workflow-updated", "suggestionId": "string", "suggestionStatus": "pending|confirmed|cancelled|failed" } },
        { "name": "checkin:analytics-updated", "status": "observed", "idempotency": "analyticsAsOf", "payload": { "type": "analytics-updated", "analyticsAsOf": "string?" }, "note": "不订阅（D-0011：高频触发会挤占滚动窗口；消费方出现再按需接）" }
      ],
      "hubIntegration": "checkin.items/record/summary 透传适配器（源能力协商）"
    },
    {
      "pluginId": "siyuan-contacts",
      "displayName": "小驴人脉",
      "maturity": "stable",
      "version": "0.4.1",
      "protocol": "window.LvContacts v1",
      "windowBridge": "LvContacts",
      "capabilities": ["searchPeople", "getPerson", "ensurePerson", "recordInteraction"],
      "hubIntegration": "contacts.search/ensure/interaction 透传适配器"
    },
    {
      "pluginId": "siyuan-butler",
      "displayName": "小驴管家",
      "maturity": "design",
      "version": "0.1.0",
      "protocol": "规划中（home RPC / 归档关联）",
      "capabilities": [],
      "hubIntegration": "仅 manifest/诊断；不进入默认工作流"
    },
    {
      "pluginId": "siyuan-flashcards",
      "displayName": "小驴闪卡",
      "maturity": "design",
      "version": "0.5.0",
      "protocol": "规划中（Gateway / lv-cards:* 事件）",
      "capabilities": [],
      "events": [
        { "name": "lv-cards:reviewed", "status": "design", "idempotency": "sessionId+cardId" }
      ],
      "hubIntegration": "仅 manifest/诊断"
    },
    {
      "pluginId": "siyuan-exam",
      "displayName": "小驴考试",
      "maturity": "design",
      "version": "0.1.0",
      "protocol": "规划中",
      "capabilities": [],
      "hubIntegration": "仅 manifest/诊断"
    },
    {
      "pluginId": "siyuan-shiyi",
      "displayName": "小驴拾遗",
      "maturity": "unlocated",
      "version": null,
      "protocol": null,
      "capabilities": [],
      "hubIntegration": "仓库未定位；只显示能力缺失诊断，不注册 adapter"
    }
  ]
}
