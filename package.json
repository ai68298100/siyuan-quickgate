{
  "name": "siyuan-quickgate",
  "version": "0.7.3",
  "type": "module",
  "description": "Lv QuickGate: SiYuan ecosystem hub & external gateway (command registry, data pass-through, editor context, NDJSON bridge)",
  "repository": "https://github.com/ai68298100/siyuan-quickgate",
  "homepage": "https://github.com/ai68298100/siyuan-quickgate",
  "author": "ai68298100",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "run-p dev:app dev:kernel",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "check": "run-s check:types check:version check:svelte",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:version": "node --no-warnings ./scripts/check-version.mjs",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node ./scripts/clean.js",
    "build": "run-s clean build:app build:kernel",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "smoke:mcp": "node tools/mcp-smoke.mjs",
    "verify:restart": "node tools/verify-restart.mjs",
    "build:mcp": "node scripts/build-mcp.mjs",
    "accept": "run-s test smoke:mcp"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/livereload": "^0.9.5",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "js-yaml": "^5.4.1",
    "livereload": "^0.9.3",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "sass": "^1.103.1",
    "siyuan": "1.2.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^3.2.7"
  }
}
