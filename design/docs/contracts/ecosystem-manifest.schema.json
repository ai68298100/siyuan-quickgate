{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/<owner>/siyuan-quickgate/main/docs/contracts/ecosystem-manifest.schema.json",
  "title": "QuickerGate Ecosystem Manifest",
  "description": "C9 生态清单合同（docs/contracts/ecosystem-manifest-contract.md）的机器形状。version=1 宽容校验（v1 现状）；version>=2 强制 v2 新增字段（sourceOfTruth/ingestion/eventNamespace）。可执行校验器：scripts/validate-ecosystem-manifest.mjs（同规则零依赖实现）。",
  "type": "object",
  "required": ["version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1, "description": "1=v1 现状形状；2=本 schema 目标形状" },
    "updatedAt": { "type": "string", "description": "最近校准日期（ISO 日期）" },
    "note": { "type": "string" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "maturity": { "enum": ["stable", "design", "unlocated"] },
    "ingestion": { "enum": ["none", "eventFile", "windowEvent"] },
    "domainRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "description": "权威数据域，如 checkin.events" },
    "protocolVersion": { "type": "string", "pattern": "^v[0-9]+$" },
    "event": {
      "type": "object",
      "required": ["name", "status", "idempotency"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$", "description": "<eventNamespace>:<kebab-verb>" },
        "status": { "enum": ["available", "observed", "design"] },
        "idempotency": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "since": { "type": "string", "description": "上游引入版本（v2 新增·optional）" },
        "note": { "type": "string" }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["pluginId", "displayName", "maturity", "version", "protocol", "capabilities", "hubIntegration"],
      "additionalProperties": false,
      "properties": {
        "pluginId": { "type": "string", "pattern": "^siyuan-[a-z][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "maturity": { "$ref": "#/$defs/maturity" },
        "version": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "protocol": { "type": ["string", "null"] },
        "minProtocol": { "oneOf": [{ "$ref": "#/$defs/protocolVersion" }, { "type": "null" }], "description": "v2 新增：快门接入的最低协议 major；未接入=null" },
        "windowBridge": { "type": "string" },
        "sourceOfTruth": { "type": "array", "items": { "$ref": "#/$defs/domainRef" }, "description": "v2 新增：该插件权威的数据域" },
        "ingestion": { "$ref": "#/$defs/ingestion", "description": "v2 新增：事件物化载体" },
        "eventNamespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "v2 新增：事件名前缀；有 events 必填" },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "capabilitySchemas": {
          "type": "object",
          "description": "v2 新增·optional：逐能力参数 schema（planned，逐能力补齐）",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "required": { "type": "array", "items": { "type": "string" } },
              "properties": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "hubIntegration": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "events": { "minItems": 1 } }, "required": ["events"] },
          "then": { "required": ["eventNamespace"] }
        },
        {
          "if": { "properties": { "version": { "type": "string" } }, "required": ["version"] },
          "then": { "properties": { "minProtocol": { "type": ["string", "null"] } } }
        }
      ]
    }
  },
  "if": { "properties": { "version": { "type": "integer", "minimum": 2 } }, "required": ["version"] },
  "then": {
    "properties": {
      "plugins": {
        "items": {
          "required": ["sourceOfTruth", "ingestion"],
          "if": { "properties": { "maturity": { "const": "stable" }, "protocol": { "type": "string", "pattern": "^window\\." } } },
          "then": {
            "properties": { "minProtocol": { "type": "string" } },
            "required": ["minProtocol"]
          }
        }
      }
    }
  }
}
